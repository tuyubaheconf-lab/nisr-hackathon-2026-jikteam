# Environment variables for SokoRyari?'s live price layer.
# Copy to `.env` for local work, or paste the names into your host's
# environment UI (Netlify: Site settings → Environment variables;
# Vercel: Project → Settings → Environment Variables).
#
# NEVER commit a filled-in copy of this file. `.env` is gitignored.

# --- database -----------------------------------------------------------------
# Where the live snapshot lives. Either URL form works.
TURSO_DATABASE_URL=turso://DATABASE-ORG.turso.io

# Write token: only pipeline/live.py needs it.
# Create with:  turso db tokens create <database-name>
TURSO_AUTH_TOKEN=

# Read-only token: preferred by the /api/prices function, so a leak of the
# value the website can see cannot write anything.
# Create with:  turso db tokens create <database-name> --read-only
TURSO_READ_TOKEN=

# --- source -------------------------------------------------------------------
# Which feed pipeline/live.py reads: wfp (today) | esoko (once an agreement
# exists — see docs/REALTIME_DATA.md §4 for what to ask them for).
SOKO_SOURCE=wfp

# Path to an eSoko export file (CSV or JSON), used when SOKO_SOURCE=esoko.
SOKO_ESOKO_PATH=

# Set to 1 in CI so a publish failure fails the job instead of skipping.
SOKO_REQUIRE_DB=
